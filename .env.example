# --- Turso / LibSQL connection ---
# Get these from https://docs.turso.tech/sdk/ts/quickstart
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Admin authentication ---
# Single admin account, seeded into the admin_users table.
# username: CROBF admin login name.
# password_hash: bcrypt hash of the admin password. Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
